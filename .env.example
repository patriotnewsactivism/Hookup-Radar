# Convex deployment URL
VITE_CONVEX_URL=

# For local development with Convex
# CONVEX_DEPLOY_KEY=

# Auth private keys (runtime secrets; never commit values)
# AUTH_PRIVATE_KEY=
# JWT_PRIVATE_KEY=

# External Viktor tools are disabled unless explicitly enabled server-side.
# VIKTOR_SPACES_ENABLED=false
# VIKTOR_SPACES_API_URL=
# VIKTOR_SPACES_PROJECT_NAME=
# VIKTOR_SPACES_PROJECT_SECRET=

# E2E credentials are consumed only by Node test scripts. Do not prefix these
# with VITE_ because Vite-prefixed variables are bundled into browser assets.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# E2E_TEST_NAME=E2E Test User
